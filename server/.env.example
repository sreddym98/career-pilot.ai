# careerpilot.ai server config. Copy to .env for local dev. Never commit real values.
# Every name below is read by server/api/settings.py.

# ── Required ─────────────────────────────────────────────────────────────────
ENV=dev                                   # prod on Render (refuses to start in prod without the items below)
DATABASE_URL=sqlite:///./dev.db           # prod: Neon Postgres URL (postgresql+psycopg://...?sslmode=require)
AUTH_SECRET=                              # prod: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_DAYS=7
FRONTEND_URL=http://localhost:3000        # prod: https://<site>.pages.dev, no trailing slash
REDIS_URL=redis://localhost:6379/0        # unused on the free stack

# ── AI (pick one provider) ───────────────────────────────────────────────────
AI_PROVIDER=auto                          # auto | openai | anthropic | ollama
AI_BASE_URL=                              # e.g. https://api.ashna.ai/v1/api
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_FAST_MODEL=claude-haiku-4.5
ANTHROPIC_API_KEY=                        # alternative: Anthropic direct
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
OLLAMA_URL=http://localhost:11434         # dev only

# ── Billing (Stripe; run server/setup_stripe.py to get the price IDs) ────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_3MO=
STRIPE_PRICE_PRO_6MO=
STRIPE_PRICE_RECRUITER=
STRIPE_PRICE_EVAL=

# ── Gmail + Twilio ───────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
INTEGRATION_ENCRYPTION_KEY=               # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=CareerPilot <noreply@careerpilot.ai>   # must be on a Resend-verified domain

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=                              # same value as the GitHub Actions secret; unset = /api/autopilot/tick closed

# ── Ingest (read by server/ingest/*, not by settings.py) ─────────────────────
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_KEY=
USAJOBS_EMAIL=

# ── Legacy auth (optional) ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_JWT_SECRET=
